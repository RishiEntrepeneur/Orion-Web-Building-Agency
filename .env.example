# Where briefs from the contact form are delivered.
# Without RESEND_API_KEY the endpoint validates and records the brief, and the
# form says plainly that delivery is not configured -- it never reports a send
# that did not happen.
RESEND_API_KEY=
CONTACT_TO=rishiorion2912@gmail.com
# Must be a domain verified in Resend. The onboarding sender only delivers to
# the address that owns the Resend account.
CONTACT_FROM=Orion <onboarding@resend.dev>

# Used for absolute URLs in metadata (Open Graph, canonical).
NEXT_PUBLIC_SITE_URL=https://orion.studio
