{
  "name": "orion-3d-agency",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "description": "Immersive dark-themed landing page for a 3D & AI website agency.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "artifact": "esbuild tools/artifact/entry.tsx --bundle --minify --format=iife --jsx=automatic --alias:next/link=./tools/artifact/link.tsx --alias:next/navigation=./tools/artifact/navigation.ts --alias:@=. --loader:.css=empty --outfile=.artifact/app.js && tailwindcss -i app/globals.css -o .artifact/app.css --minify"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
